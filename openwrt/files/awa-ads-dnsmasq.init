#!/bin/sh /etc/rc.common
# awa-ads-dnsmasq：开机后同步秋风广告规则到 dnsmasq
#
# conf-dir 在 tmpfs，重启会清空，所以每次开机都要重新写入规则。
# 规则来自 /etc/awa-ads-dnsmasq/ads.conf 缓存，通常不需要重新下载。

START=96
STOP=10

PROG=/usr/bin/awa-ads-dnsmasq

start() {
	(
		# 等网络就绪：能解析就说明 DNS 通了，比 ping 更贴近实际需要
		i=0
		while [ $i -lt 60 ]; do
			nslookup baidu.com 127.0.0.1 >/dev/null 2>&1 && break
			i=$((i + 1))
			sleep 2
		done
		if [ $i -ge 60 ]; then
			logger -t awa-ads "等待网络超时，仍尝试同步规则"
		fi

		"$PROG" 2>&1 | logger -t awa-ads
	) &
}

stop() {
	:
}

restart() {
	stop
	start
}

# 移除规则
uninstall_rules() {
	local dir
	dir=$(uci -q get dhcp.@dnsmasq[0].confdir)
	[ -z "$dir" ] && dir=$(ls -d /tmp/dnsmasq*.d 2>/dev/null | head -n1)
	[ -z "$dir" ] && dir=/tmp/dnsmasq.d

	rm -f "$dir/awa-ads-dnsmasq.conf" "$dir/.awa-ads-dnsmasq.conf.tmp"
	/etc/init.d/dnsmasq restart
	logger -t awa-ads "已移除规则"
}

disable() {
	uninstall_rules
}
